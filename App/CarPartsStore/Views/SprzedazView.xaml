<UserControl x:Class="CarPartsStore.Views.SprzedazView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:vm="clr-namespace:CarPartsStore.ViewModels">

    <UserControl.DataContext>
        <vm:SprzedazViewModel/>
    </UserControl.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                   Text="Sprzedaż"
                   FontSize="20" FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <materialDesign:Card Grid.Row="0" Padding="12" Margin="0,0,0,10">
                <TextBox materialDesign:HintAssist.Hint="Szukaj części po nazwie..."
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Text="{Binding TekstWyszukiwania, UpdateSourceTrigger=PropertyChanged}"/>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="1">
                <DataGrid ItemsSource="{Binding DostepneCzesci}"
                          SelectedItem="{Binding WybranaCzesc, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          RowBackground="{DynamicResource MaterialDesignPaper}"
                          AlternatingRowBackground="{DynamicResource MaterialDesignChipBackground}"
                          Style="{StaticResource MaterialDesignDataGrid}"
                          materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="8">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="{DynamicResource PrimaryHueDarkBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueDarkForegroundBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Height" Value="44"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SecondaryHueMidBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryHueMidForegroundBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SecondaryHueMidBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryHueMidForegroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource SecondaryHueMidBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nazwa" Binding="{Binding Nazwa}" Width="*"/>
                        <DataGridTextColumn Header="Nr Katalogowy" Binding="{Binding NrKatalogowy}" Width="140"/>
                        <DataGridTextColumn Header="Cena" Binding="{Binding Cena, StringFormat={}{0:N2} zł}" Width="110"/>
                        <DataGridTextColumn Header="Stan" Binding="{Binding StanMagazynowy}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="2" Padding="12" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBox materialDesign:HintAssist.Hint="Ilość"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             Text="{Binding IloscDoDodania, UpdateSourceTrigger=PropertyChanged}"
                             Width="80" Margin="0,0,16,0"/>
                    <Button Command="{Binding DodajDoKoszykaCommand}"
                            Style="{StaticResource MaterialDesignFlatLightBgButton}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CartPlus" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="DODAJ DO KOSZYKA"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <materialDesign:Card Grid.Row="0" Padding="12" Margin="0,0,0,10">
                <ComboBox materialDesign:HintAssist.Hint="Wybierz klienta"
                          Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                          ItemsSource="{Binding Klienci}"
                          DisplayMemberPath="NazwaFirmy"
                          SelectedItem="{Binding WybranyKlient, Mode=TwoWay}"/>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="1">
                <DataGrid ItemsSource="{Binding Koszyk}"
                          SelectedItem="{Binding WybranaPozycjaKoszyka, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          RowBackground="{DynamicResource MaterialDesignPaper}"
                          AlternatingRowBackground="{DynamicResource MaterialDesignChipBackground}"
                          Style="{StaticResource MaterialDesignDataGrid}"
                          materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="8">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="{DynamicResource PrimaryHueDarkBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueDarkForegroundBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Height" Value="44"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SecondaryHueMidBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryHueMidForegroundBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SecondaryHueMidBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryHueMidForegroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource SecondaryHueMidBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Część" Binding="{Binding NazwaCzesci}" Width="*"/>
                        <DataGridTextColumn Header="Ilość" Binding="{Binding Ilosc}" Width="60"/>
                        <DataGridTextColumn Header="Cena" Binding="{Binding CenaJednostkowa, StringFormat={}{0:N2} zł}" Width="90"/>
                        <DataGridTextColumn Header="Suma" Binding="{Binding Suma, StringFormat={}{0:N2} zł}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,10">
                <Button Command="{Binding UsunZKoszykaCommand}"
                        Style="{StaticResource MaterialDesignFlatDarkBgButton}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Delete" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="USUŃ POZYCJĘ"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding WyczyscKoszykCommand}"
                        Style="{StaticResource MaterialDesignFlatDarkBgButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CartRemove" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="WYCZYŚĆ KOSZYK"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <materialDesign:Card Grid.Row="3" Padding="16" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Pozycji w koszyku: " FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding LiczbaPozycji}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Do zapłaty: "
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                        <TextBlock Text="{Binding SumaCalkowita, StringFormat={}{0:N2} zł}"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <Button Grid.Row="4"
                    Command="{Binding FinalizujCommand}"
                    Style="{StaticResource MaterialDesignFlatLightBgButton}"
                    Height="48">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Check" VerticalAlignment="Center" Margin="0,0,8,0" Width="20" Height="20"/>
                    <TextBlock Text="FINALIZUJ ZAMÓWIENIE" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
