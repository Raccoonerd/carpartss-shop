<UserControl x:Class="CarPartsStore.Views.PartsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:vm="clr-namespace:CarPartsStore.ViewModels">

	<UserControl.DataContext>
		<vm:PartsViewModel/>
	</UserControl.DataContext>

	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="2*"/>
			<ColumnDefinition Width="10"/>
			<ColumnDefinition Width="1*"/>
		</Grid.ColumnDefinitions>

		<TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                   Text="Zarządzanie częściami"
                   FontSize="20" FontWeight="Bold"
                   Margin="0,0,0,10"/>

		<materialDesign:Card Grid.Row="1" Grid.Column="0" Padding="12" Margin="0,0,0,10">
			<TextBox materialDesign:HintAssist.Hint="Szukaj po nazwie..."
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
		</materialDesign:Card>

		<materialDesign:Card Grid.Row="2" Grid.Column="0">
			<DataGrid ItemsSource="{Binding Parts}"
                      SelectedItem="{Binding SelectedPart, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      RowBackground="{DynamicResource MaterialDesignPaper}"
                      AlternatingRowBackground="{DynamicResource MaterialDesignChipBackground}"
                      Style="{StaticResource MaterialDesignDataGrid}"
                      materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="8">

				<DataGrid.ColumnHeaderStyle>
					<Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
						<Setter Property="Background" Value="{DynamicResource PrimaryHueDarkBrush}"/>
						<Setter Property="Foreground" Value="{DynamicResource PrimaryHueDarkForegroundBrush}"/>
						<Setter Property="FontWeight" Value="SemiBold"/>
						<Setter Property="Height" Value="44"/>
					</Style>
				</DataGrid.ColumnHeaderStyle>

				<DataGrid.RowStyle>
					<Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
						<Setter Property="Background" Value="Transparent"/>
						<Style.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter Property="Background" Value="{DynamicResource SecondaryHueMidBrush}"/>
								<Setter Property="Foreground" Value="{DynamicResource SecondaryHueMidForegroundBrush}"/>
							</Trigger>
						</Style.Triggers>
					</Style>
				</DataGrid.RowStyle>

				<DataGrid.CellStyle>
					<Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
						<Style.Triggers>
							<Trigger Property="IsSelected" Value="True">
								<Setter Property="Background" Value="{DynamicResource SecondaryHueMidBrush}"/>
								<Setter Property="Foreground" Value="{DynamicResource SecondaryHueMidForegroundBrush}"/>
								<Setter Property="BorderBrush" Value="{DynamicResource SecondaryHueMidBrush}"/>
							</Trigger>
						</Style.Triggers>
					</Style>
				</DataGrid.CellStyle>

				<DataGrid.Columns>
					<DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" Width="*"/>
					<DataGridTextColumn Header="Nr Katalogowy" Binding="{Binding CatalogNumber}" Width="120"/>
					<DataGridTextColumn Header="Kategoria" Binding="{Binding Category.Name}" Width="120"/>
					<DataGridTextColumn Header="Cena" Binding="{Binding Price, StringFormat={}{0:N2} zł}" Width="100"/>
					<DataGridTextColumn Header="Stan" Binding="{Binding StockQuantity}" Width="100"/>
				</DataGrid.Columns>
			</DataGrid>
		</materialDesign:Card>

		<materialDesign:Card Grid.Row="1" Grid.RowSpan="2" Grid.Column="2">
			<StackPanel>
				<TextBlock Text="Formularz"
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           Margin="0,0,0,10"/>

				<TextBox materialDesign:HintAssist.Hint="Nazwa"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16"/>

				<TextBox materialDesign:HintAssist.Hint="Numer katalogowy"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Text="{Binding FormCatalogNumber, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16"/>

				<ComboBox materialDesign:HintAssist.Hint="Kategoria"
                          Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                          ItemsSource="{Binding Categories}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding FormCategoryId}"
                          Margin="0,0,0,16"/>

				<TextBox materialDesign:HintAssist.Hint="Cena (zł)"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Text="{Binding FormPrice, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16"/>

				<TextBox materialDesign:HintAssist.Hint="Stan magazynowy"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Text="{Binding FormStock, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,24"/>

				<Button Command="{Binding AddCommand}"
                        Style="{StaticResource MaterialDesignFlatLightBgButton}"
                        Margin="0,0,0,8">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,8,0"/>
						<TextBlock Text="DODAJ"/>
					</StackPanel>
				</Button>

				<Button Command="{Binding SaveCommand}"
                        Style="{StaticResource MaterialDesignFlatLightBgButton}"
                        Margin="0,0,0,8">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" Margin="0,0,8,0"/>
						<TextBlock Text="ZAPISZ ZMIANY"/>
					</StackPanel>
				</Button>

				<Button Command="{Binding DeleteCommand}"
                        Style="{StaticResource MaterialDesignFlatDarkBgButton}"
                        Margin="0,0,0,8">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon Kind="Delete" VerticalAlignment="Center" Margin="0,0,8,0"/>
						<TextBlock Text="USUŃ"/>
					</StackPanel>
				</Button>

				<Button Command="{Binding ClearCommand}"
                        Style="{StaticResource MaterialDesignFlatDarkBgButton}"
                        Content="WYCZYŚĆ"/>
			</StackPanel>
		</materialDesign:Card>
	</Grid>
</UserControl>
